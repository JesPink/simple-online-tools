# Cloudflare Pages Headers Configuration - DEVELOPMENT-FRIENDLY CACHING

# DEVELOPMENT MODE: CSS files - short cache during active development
/tools/*/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/styles/*
  Cache-Control: public, max-age=3600, must-revalidate

# DEVELOPMENT MODE: Main app JS - short cache for rapid updates
/app.js
  Cache-Control: public, max-age=3600, must-revalidate

# STATIC ASSETS: Keep long cache for truly static content
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ACTIVE DEVELOPMENT: Tool JavaScript - very short cache for instant updates
/tools/*/index.js
  Cache-Control: public, max-age=300, must-revalidate

# DYNAMIC CONTENT: HTML files - very short cache for content updates
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/tools/*/index.html
  Cache-Control: public, max-age=300, must-revalidate

# Special files - Override Cloudflare managed content
/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain
  X-Robots-Tag: noindex

/sitemap.xml
  Cache-Control: public, max-age=86400

# Security headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noai, noimageai