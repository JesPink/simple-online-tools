{
  "name": "free-tools-platform",
  "version": "1.0.0",
  "description": "High-performance, SEO-first platform for free online tools",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run build:watch\" \"npm run serve\"",
    "build": "npm run validate && node esbuild.config.js",
    "build:watch": "npm run validate && node esbuild.config.js --watch",
    "validate": "node scripts/validate-foundation.js",
    "validate:tool": "node scripts/validate-foundation.js",
    "validate:strict": "node scripts/validate-foundation.js --strict",
    "create-tool": "node scripts/scaffold-tool.js",
    "setup-hooks": "node scripts/setup-hooks.js",
    "pre-commit": "npm run validate:strict",
    "serve": "live-server dist --port=3000 --no-browser --wait=500"
  },
  "keywords": [
    "tools",
    "free",
    "online",
    "seo",
    "static",
    "performance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.19.0",
    "jspdf": "^3.0.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2"
  }
}
